# === Document CV model paths (relative to backend/) ===
YOLO_SEG_ONNX_PATH=models/yolo26n_seg_document.onnx
YOLO_CONFIDENCE_THRESHOLD=0.50
YOLO_IOU_THRESHOLD=0.45
YOLO_INPUT_SIZE=640
YOLO_MODEL_VERSION=yolo26n-seg-document-v1

MOBILENET_CLASSIFIER_ONNX_PATH=models/mobilenetv3_indian_docs.onnx
MOBILENET_CLASSIFIER_THRESHOLD=0.50
MOBILENET_MODEL_VERSION=mobilenetv3-large-indian-docs-v1

PP_LCNET_ORIENTATION_DIR=models/pp_lcnet_doc_ori
PP_LCNET_MODEL_VERSION=PP-LCNet_x1_0_doc_ori

UVDoc_ENABLED=false
UVDoc_MODEL_DIR=models/uvdoc

ONNX_INFERENCE_BACKEND=onnxruntime
# ONNX_EXECUTION_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

PADDLEOCR_LANG=en
PADDLEOCR_USE_ANGLE_CLS=true
PADDLEOCR_VERSION=paddleocr-v2
